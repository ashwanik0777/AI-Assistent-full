# ──────────────────────────────────────────
# AIRA Platform — Environment Configuration
# ──────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME=aira-platform
APP_VERSION=1.5.0
APP_PORT=3001
APP_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_APP_NAME=AIRA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://aira:aira_dev_password@localhost:5432/aira_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Feature Flags
FEATURE_FLAG_DARK_MODE=true
FEATURE_FLAG_REGISTRATION=true
