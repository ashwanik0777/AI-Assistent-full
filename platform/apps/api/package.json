    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@aira/types": "workspace:*",
    "@aira/config": "workspace:*",
    "@aira/logger": "workspace:*",
    "@aira/constants": "workspace:*",
    "@aira/security": "workspace:*",
    "@aira/validation": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
