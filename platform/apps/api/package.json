{
  "name": "@aira/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIRA Platform — NestJS API Server",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
